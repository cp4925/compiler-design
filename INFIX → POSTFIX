#include <stdio.h>
#include <ctype.h>

char stack[20];
int top = -1;

void push(char c) { stack[++top] = c; }
char pop() { return stack[top--]; }

int precedence(char c) {
    if(c=='+' || c=='-') return 1;
    if(c=='*' || c=='/') return 2;
    return 0;
}

int main() {
    char infix[20], postfix[20];
    int i=0, k=0;

    printf("Enter infix expression: ");
    scanf("%s", infix);

    while(infix[i]) {
        if(isalnum(infix[i]))
            postfix[k++] = infix[i];
        else {
            while(top!=-1 && precedence(stack[top]) >= precedence(infix[i]))
                postfix[k++] = pop();
            push(infix[i]);
        }
        i++;
    }

    while(top!=-1)
        postfix[k++] = pop();

    postfix[k] = '\0';

    printf("Postfix: %s\n", postfix);
    return 0;
}