#include <stdio.h>

int main() {
    printf("Expression: a = b + c * d\n\n");

    printf("Quadruple:\n");
    printf("1: (*, c, d, t1)\n");
    printf("2: (+, b, t1, t2)\n");
    printf("3: (=, t2, -, a)\n");

    printf("\nTriple:\n");
    printf("0: (*, c, d)\n");
    printf("1: (+, b, (0))\n");
    printf("2: (=, (1), a)\n");

    printf("\nIndirect Triple:\n");
    printf("Pointer Table: 0->2, 1->0, 2->1\n");

    return 0;
}