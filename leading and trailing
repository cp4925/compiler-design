#include <stdio.h>
#include <ctype.h>

int main() {
    char production[20];
    printf("Enter production (E->E+T): ");
    scanf("%s", production);

    printf("\nLEADING: ");
    for(int i = 3; production[i] != '\0'; i++) {
        if(!isupper(production[i])) {
            printf("%c ", production[i]);
            break;
        }
    }

    printf("\nTRAILING: ");
    for(int i = strlen(production)-1; i >= 3; i--) {
        if(!isupper(production[i])) {
            printf("%c ", production[i]);
            break;
        }
    }

    return 0;
}